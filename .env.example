# ==========================================
# XianQi 平台环境变量配置模板
# 复制为 .env 后修改对应值
# ==========================================

# ---------- 数据库 ----------
MYSQL_ROOT_PASSWORD=xianqi_root_123
MYSQL_DATABASE=Xianqi
MYSQL_USER=xianqi
MYSQL_PASSWORD=xianqi123
MYSQL_PORT=3307

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6380
REDIS_PASSWORD=

# ---------- 后端服务 ----------
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# JWT 配置（生产环境务必修改）
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRE_HOURS=24
JWT_REFRESH_EXPIRE_DAYS=7

# ---------- 文件上传 ----------
UPLOAD_PATH=/app/uploads
OSS_ENABLED=false
OSS_ENDPOINT=oss-cn-guangzhou.aliyuncs.com
OSS_BUCKET_NAME=campus-trade
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# ---------- AI（厂商无关） ----------
# provider 目前支持：zhipu
AI_ENABLED=false
AI_PROVIDER=zhipu
AI_API_KEY=
AI_BASE_URL=https://open.bigmodel.cn/
AI_TIMEOUT_MS=60000
AI_CHAT_MODEL=glm-4-flash
AI_CHAT_TEMPERATURE=0.7
AI_CHAT_MAX_TOKENS=2000
AI_CHAT_MEMORY_SIZE=20
AI_CHAT_MAX_MEMORY_USERS=1000
AI_CHAT_MAX_RETRIES=2
AI_CHAT_STREAM_ENABLED=true

# ---------- 短信服务 ----------
SMS_ENABLED=false
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# ---------- 支付宝 ----------
ALIPAY_MOCK=true
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# ---------- 高德地图 ----------
AMAP_ENABLED=false
AMAP_WEB_KEY=
AMAP_MINIPROGRAM_KEY=

# ---------- Nginx 网关 ----------
NGINX_PORT=8088
SERVER_NAME=xianqi.local

# ---------- 开发工具（dev profile） ----------
PHPMYADMIN_PORT=8089
REDIS_COMMANDER_PORT=8090
