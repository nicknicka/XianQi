# 生产环境配置
NODE_ENV=production

# API 基础地址（通过 Nginx 同域代理，避免跨域）
VITE_API_BASE_URL=/api

# WebSocket 地址（通过 Nginx 同域代理）
# 注意：生产环境如果是 HTTPS，需要改成 wss://
VITE_WS_BASE_URL=ws://xianqi.local/api/ws

# 文件上传地址（相对路径，走 Nginx 代理）
VITE_UPLOAD_BASE_URL=/api/uploads

# 地图配置 (高德地图)
# Web端 (JS API) Key - 用于 H5 平台
VITE_AMAP_WEB_KEY=

# 微信小程序 Key - 用于微信小程序
VITE_AMAP_MINIPROGRAM_KEY=

# 安全密钥 - 用于高德地图 Web 服务 API
VITE_AMAP_SECRET_KEY=

# 通用 Key (兼容旧代码)
VITE_AMAP_KEY=

# 应用配置
VITE_APP_TITLE=闲七校园
VITE_APP_VERSION=1.0.0
