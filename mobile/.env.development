# 开发环境配置
NODE_ENV=development

# 是否使用 Mock API（true=使用Mock，false=使用真实后端）
VITE_USE_MOCK=false

# API 基础地址（开发环境）
# 使用 nginx 反向代理，通过 1277 端口访问
# 当前机器局域网 IP：192.168.137.55
# H5 与微信小程序统一使用可访问的局域网地址，避免小程序图片资源将 localhost 解析为本地路径
VITE_API_BASE_URL=http://192.168.137.55:1277/api

# WebSocket 地址
# ⚠️ 重要提示：
# 1. H5 环境：可以使用 ws:// 或 wss:// 协议
# 2. 微信小程序：必须使用 wss:// 协议 + 备案域名
# 3. 开发环境：在微信开发者工具中可以临时勾选"不校验合法域名"使用 ws:// + 本地IP
# 4. 生产环境：必须使用 wss:// + 备案域名（如：wss://api.example.com/api/ws）
# 5. 注意：后端 context-path 是 /api，所以 WebSocket 端点是 /api/ws

# 当前配置（开发环境，通过 nginx 代理）
VITE_WS_BASE_URL=ws://192.168.137.55:1277/api/ws

# 生产环境配置示例（需要替换为真实域名）
# VITE_WS_BASE_URL=wss://api.yourdomain.com/api/ws

# OSS 配置（本地开发时使用本地存储）
VITE_OSS_ENABLED=false
VITE_OSS_ENDPOINT=
VITE_OSS_ACCESS_KEY_ID=
VITE_OSS_ACCESS_KEY_SECRET=
VITE_OSS_BUCKET_NAME=
VITE_OSS_BASE_URL=

# 本地文件上传地址（通过 nginx 代理）
VITE_UPLOAD_BASE_URL=http://192.168.137.55:1277/api/uploads

# 地图配置 (高德地图)
# Web端 (JS API) Key - 用于 H5 平台
VITE_AMAP_WEB_KEY=7e071485f74c44fd2409ca2d58cb8d80

# 微信小程序 Key - 用于微信小程序
VITE_AMAP_MINIPROGRAM_KEY=c9591b14047c811903c8aafc4ec832f7

# 安全密钥 - 用于高德地图 Web 服务 API
VITE_AMAP_SECRET_KEY=afafe9b90a37567f9a5b47cd677a7df5

# 通用 Key (兼容旧代码)
VITE_AMAP_KEY=7e071485f74c44fd2409ca2d58cb8d80

# 应用配置
VITE_APP_TITLE=闲七校园
VITE_APP_VERSION=1.0.0

# 数据库配置（仅用于测试，不要在生产环境暴露）
DB_HOST=localhost
DB_PORT=3306
DB_NAME=XianQi
DB_USER=root
DB_PASSWORD=123456
