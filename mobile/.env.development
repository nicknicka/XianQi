# 开发环境配置
NODE_ENV=development

# 是否使用 Mock API（true=使用Mock，false=使用真实后端）
VITE_USE_MOCK=false

# API 基础地址（开发环境）
# 默认走 Docker Nginx 网关；如果本地直接跑 vite dev，改为 http://localhost:8080/api
# 微信小程序真机调试需要改成局域网 IP，如 http://192.168.x.x:8088/api
VITE_API_BASE_URL=http://localhost:8088/api

# WebSocket 地址
# H5 可用 ws://，微信小程序必须是 wss:// + 备案域名
VITE_WS_BASE_URL=ws://localhost:8088/api/ws

# OSS 配置（本地开发使用本地存储）
VITE_OSS_ENABLED=false
VITE_OSS_ENDPOINT=
VITE_OSS_ACCESS_KEY_ID=
VITE_OSS_ACCESS_KEY_SECRET=
VITE_OSS_BUCKET_NAME=
VITE_OSS_BASE_URL=

# 本地文件上传地址
VITE_UPLOAD_BASE_URL=http://localhost:8088/api/uploads

# 地图配置 (高德地图)
# 各 Key 请填入自己的值，不要提交到仓库
VITE_AMAP_WEB_KEY=
VITE_AMAP_MINIPROGRAM_KEY=
VITE_AMAP_SECRET_KEY=
VITE_AMAP_KEY=

# 应用配置
VITE_APP_TITLE=闲七校园
VITE_APP_VERSION=1.0.0
